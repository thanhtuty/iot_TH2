# Copy this file to .env and fill in your own credentials.
TB_URL=https://thingsboard.cloud
TB_API_KEY=REPLACE_WITH_NEW_THINGSBOARD_API_KEY
TB_DEVICE_ID=REPLACE_WITH_DEVICE_UUID
TB_KEYS=distance_cm,humidity,rssi,sequence,temperature,uptime_s

INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_ORG=REPLACE_WITH_ORGANIZATION_ID
INFLUX_BUCKET=iot_lab2
INFLUX_TOKEN=REPLACE_WITH_INFLUX_TOKEN
